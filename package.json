{
  "name": "istikbal-aerospace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "İstikbal Aerospace Next.js web application.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "build:vinext": "vite build",
    "deploy:vinext": "vinext-cloudflare deploy",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests next.config.ts playwright.config.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "node scripts/preview.mjs",
    "test:browser": "playwright test",
    "cms:inventory": "node --import tsx scripts/cms/inventory.ts",
    "cms:inventory:check": "node --import tsx scripts/cms/inventory.ts --check",
    "cms:release:check": "node --import tsx scripts/cms/release-inventory.ts",
    "cms:snapshots:check": "node --import tsx scripts/cms/snapshot.ts --check",
    "cms:seed:check": "node --import tsx scripts/cms/seed.ts --check",
    "cms:pages:check": "node --import tsx scripts/cms/page-schema.ts --check && node --import tsx scripts/cms/page-seed.ts --check",
    "cms:test:auth": "node scripts/cms/local-auth.mjs",
    "cms:hosting:prepare": "node scripts/cms/prepare-cloudflare.mjs",
    "cms:admin:provision": "node scripts/cms/provision-admin.mjs"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.3.4",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "image-size": "2.1.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.17",
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "cf": "1.0.0-beta.32",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "parse5": "8.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "overrides": {
    "fflate": "0.7.5",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    }
  }
}
